// ApexRuntime weapon capture (offline Flowstate only), client half: one
// "[WLOG] f" line per frame while running (time, weapon, clip, reloading,
// ADS fraction, eye and camera angles, viewmodel sequence).

global function ClientCodeCallback_ApexRuntime_WeaponLog_ModInit
global function WLog_Start
global function WLog_Stop

struct
{
	int gen = 0
} file

void function ClientCodeCallback_ApexRuntime_WeaponLog_ModInit()
{
	printt( "[WLOG] client ready" )
}

void function WLog_Start( string tag )
{
	file.gen++
	thread WLog_Thread( file.gen, tag )
	AgentLink_Reply( "{\"ok\":true}" )
}

void function WLog_Stop()
{
	file.gen++
	AgentLink_Reply( "{\"ok\":true}" )
}

void function WLog_Thread( int gen, string tag )
{
	while ( gen == file.gen )
	{
		entity p = GetLocalViewPlayer()
		if ( IsValid( p ) )
		{
			entity w = p.GetActiveWeapon( eActiveInventorySlot.mainHand )
			string name = "none"
			int clip = -1
			int reloading = 0
			if ( IsValid( w ) )
			{
				name = w.GetWeaponClassName()
				clip = w.GetWeaponPrimaryClipCount()
				if ( w.IsReloading() )
					reloading = 1
			}
			string seq = "-"
			entity vm = p.GetViewModelEntity()
			if ( IsValid( vm ) )
			{
				try { seq = vm.GetCurrentSequenceName() } catch ( e1 ) {}
			}
			float zoom = 0.0
			try { zoom = p.GetZoomFrac() } catch ( e2 ) {}
			vector eye = p.EyeAngles()
			vector cam = p.CameraAngles()
			// Movement and weapon state (each guarded: not every build has
			// every query).
			int spr = 0
			int gnd = 0
			int crh = 0
			int sld = 0
			int mnt = 0
			int rdy = 0
			int act = -1
			int ms = -1
			try { spr = p.IsSprinting() ? 1 : 0 } catch ( e3 ) {}
			try { gnd = p.IsOnGround() ? 1 : 0 } catch ( e4 ) {}
			try { crh = p.IsCrouched() ? 1 : 0 } catch ( e5 ) {}
			try { sld = p.IsSliding() ? 1 : 0 } catch ( e6 ) {}
			try { mnt = p.IsMantling() ? 1 : 0 } catch ( e7 ) {}
			if ( IsValid( w ) )
			{
				try { rdy = w.IsReadyToFire() ? 1 : 0 } catch ( e8 ) {}
				try { act = w.GetWeaponActivity() } catch ( e9 ) {}
				try { ms = w.GetReloadMilestoneIndex() } catch ( e10 ) {}
			}
			vector vel = p.GetVelocity()
			float speed = Length( < vel.x, vel.y, 0.0 > )
			printt( format( "[WLOG] f %s %.4f %s %d %d %.3f %.4f %.4f %.4f %.4f %.4f %s %d %d %d %d %d %d %d %d %.1f", tag, Time(), name, clip, reloading, zoom, eye.x, eye.y, cam.x, cam.y, cam.z, seq, spr, gnd, crh, sld, mnt, rdy, act, ms, speed ) )
		}
		WaitFrame()
	}
}
